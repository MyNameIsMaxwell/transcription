# Yandex AI Studio: API-ключ сервисного аккаунта и каталог
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель диалога (OpenAI-совместимый API AI Studio)
YANDEX_LLM_MODEL=aliceai-llm/latest
# Модель, понимающая картинки (необязательно). Пусто — фото только прикладываются к заявке.
YANDEX_VISION_MODEL=
# Язык SpeechKit
YANDEX_LANG=ru-RU

# Почта для готовых идей (необязательно). Без SMTP идеи только сохраняются в data/ideas.csv
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IDEAS_EMAIL_TO=

# Пароль на страницу /admin (логин любой). Пусто — админка закрыта.
ADMIN_PASSWORD=
# Лимит запросов: на диалог и на IP за окно в минутах
RATE_LIMIT_WINDOW_MIN=10
RATE_LIMIT_PER_CHAT=20
RATE_LIMIT_PER_IP=200
