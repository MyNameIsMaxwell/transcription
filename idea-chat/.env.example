# Скопируйте в .env.local и заполните:  cp .env.example .env.local
# Next.js читает .env.local автоматически. Сам .env.local в git не попадает.

# ===== ОБЯЗАТЕЛЬНО =====
# Yandex Cloud: API-ключ сервисного аккаунта и ID каталога (folder).
# Тот же ключ работает для модели (AI Studio) и для распознавания голоса (SpeechKit).
# Сервисному аккаунту нужны роли ai.languageModels.user и ai.speechkit-stt.user.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Пароль на страницу /admin (просмотр идей). Логин любой. Пусто — /admin закрыт.
ADMIN_PASSWORD=

# ===== НЕОБЯЗАТЕЛЬНО (значения по умолчанию указаны) =====
# Модель диалога в Yandex AI Studio
YANDEX_LLM_MODEL=aliceai-llm/latest
# Язык распознавания голосовых
YANDEX_LANG=ru-RU

# Лимит запросов: окно в минутах, запросов на один диалог и на один IP за окно
RATE_LIMIT_WINDOW_MIN=10
RATE_LIMIT_PER_CHAT=20
RATE_LIMIT_PER_IP=200

# Письмо с каждой новой идеей. Без SMTP_HOST и IDEAS_EMAIL_TO письма не отправляются,
# идеи всё равно сохраняются в data/ideas.db и data/ideas.csv.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IDEAS_EMAIL_TO=
