# DeepSeek API (required for summary generation)
DEEPSEEK_KEY=your_deepseek_api_key_here
# deepseek-chat снят с API. Актуальная дешёвая модель:
DEEPSEEK_MODEL=deepseek-flash
# Модель для шаблона «Описание процесса» (сильнее, ~4x дороже flash) и режим рассуждения
DEEPSEEK_PROCESS_MODEL=deepseek-v4-pro
DEEPSEEK_PROCESS_THINKING=true

# Whisper local transcription (CPU, GPU not required)
# Model sizes: tiny, base, small, medium, large
# CPU recommendation: tiny (fast) or base (balanced)
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=ru

# Compute type: int8, int8_float16, float16, float32
WHISPER_COMPUTE_TYPE=int8

# Number of CPU threads for inference
WHISPER_NUM_THREADS=4

# Yandex SpeechKit cloud transcription
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_LANG=ru-RU

# Groq Whisper (cheap cloud STT, no local model)
# Key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo

# Any OpenAI-compatible transcription API (optional)
# Example: https://api.openai.com/v1  or a self-hosted whisper server
# STT_API_BASE_URL=
# STT_API_KEY=
# STT_API_MODEL=whisper-1
STT_LANGUAGE=ru

# Optional: set custom ffmpeg path if not in PATH
# Example (Windows):
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Google Drive picker (optional). Button appears only when both are set.
# Create a Web OAuth client and API key in Google Cloud.
# Authorized JavaScript origins: http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
# GOOGLE_APP_ID=
